# Edge Base-Defense Copilot — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=edge
POSTGRES_DB=edge
POSTGRES_PASSWORD=

# Runtime connection (asyncpg, used by FastAPI and agents services)
DATABASE_URL=postgresql+asyncpg://edge:${POSTGRES_PASSWORD}@postgres:5432/edge

# Migration connection (psycopg2 sync, used by Alembic only)
DATABASE_SYNC_URL=postgresql+psycopg2://edge:${POSTGRES_PASSWORD}@postgres:5432/edge

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API ───────────────────────────────────────────────────────────────────────
# Single API key for all operator UI requests. Set to a random 32+ char string.
API_KEY=

# ── vLLM ─────────────────────────────────────────────────────────────────────
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_MAX_MODEL_LEN=8192

# ── Decision model thresholds ─────────────────────────────────────────────────
# Set from ECE calibration results, not guessed. See models/cards/ for values.
ALERT_THRESHOLD=0.55
ESCALATION_THRESHOLD=0.72

# ── Sync / GovCloud ───────────────────────────────────────────────────────────
GOVCLOUD_DB_URL=
GOVCLOUD_API_KEY=
GOVCLOUD_HEALTH_URL=
UPLINK_CHECK_INTERVAL_S=30

# ── Dev only (docker-compose.dev.yml) ─────────────────────────────────────────
# Leave empty in production. Langfuse is disabled when LANGFUSE_ENABLED is unset.
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
